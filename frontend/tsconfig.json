{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    // Recharts types its `formatter`/`labelFormatter` props contravariantly, so the
    // inline `(value: number) => string` formatters in the dashboard pages fail to
    // assign under strictFunctionTypes. Relaxed here rather than rewriting chart
    // call sites; see ARCHITECTURE.md for the list of affected files.
    "strictFunctionTypes": false,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "5.0",
    "types": ["node"],
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}