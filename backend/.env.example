# anti-spoofing model download (optional, but recommended for better accuracy)
# New-Item -ItemType Directory -Force models\anti_spoof | Out-Null
# curl.exe -L -o models\anti_spoof\MiniFASNetV2.onnx https://github.com/yakhyo/face-anti-spoofing/releases/download/weights/MiniFASNetV2.onnx
# curl.exe -L -o models\anti_spoof\MiniFASNetV1SE.onnx https://github.com/yakhyo/face-anti-spoofing/releases/download/weights/MiniFASNetV1SE.onnx
# Get-ChildItem models\anti_spoof | Select-Object Name, Length
# Get-FileHash models\anti_spoof\*.onnx -Algorithm SHA256

